# ================================
# Enterprise AI Orchestrator
# ================================

# Server
API_PORT=50000
RATE_LIMIT_PER_MINUTE=20
SESSION_EXPIRY=30m
CHAT_TIMEOUT=120s
RAG_INGEST_TIMEOUT=120s
AUDIT_TIMEOUT=5s
HEALTH_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
MIGRATION_TIMEOUT=30s
MAX_UPLOAD_MB=10

# LLM Backend
# ollama = PoC (M1/Local)
# vllm   = Production (NVIDIA)
LLM_BACKEND=ollama
LLM_HOST=host.docker.internal
LLM_PORT=11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Embedding
EMBED_HOST=host.docker.internal
EMBED_PORT=11434
EMBED_MODEL=nomic-embed-text-v2-moe

# OCR
# tesseract = local binary fallback
# ollama    = AI OCR model via Ollama /api/generate
# disabled  = reject scanned PDFs when text extraction fails
OCR_ENGINE=ollama
OCR_HOST=host.docker.internal
OCR_PORT=11434
OCR_MODEL=scb10x/typhoon-ocr1.5-3b:latest
OCR_TIMEOUT=180s
OCR_MAX_PAGES=20
OCR_PROMPT=Extract all readable text from this image. Preserve Thai and English text. Return only the extracted text.

# Database
DB_HOST=orchestrator-postgres
DB_PORT=5432
DB_NAME=orchestrator
DB_USER=orchestrator
# Development default. Production must use a real secret.
DB_PASS=changeme
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=30m
DB_POOL_MAX_CONN_IDLE_TIME=5m
DB_POOL_HEALTH_CHECK_PERIOD=1m

# Active Directory
AD_SERVER=192.168.x.x
AD_PORT=389
AD_BASE_DN=DC=your-domain,DC=com
AD_DOMAIN=your-domain.com

# JWT
# Development placeholder. Production must use a strong random value.
JWT_SECRET=change-this-to-random-string-in-production
JWT_EXPIRY=8h

# Dev Mode (ข้าม AD — ใช้เฉพาะ development เท่านั้น)
DEV_MODE=true
DEV_USERNAME=dev
DEV_PASSWORD=dev1234

# System Prompt
# Prefer file-based prompts for version control. SYSTEM_PROMPT remains as an override fallback.
SYSTEM_PROMPT_FILE=prompts/system_general.tmpl
SYSTEM_PROMPT=
