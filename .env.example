# Server
API_PORT=50000

# LLM Backend
# ollama = PoC (M1)
# vllm   = Production (NVIDIA)
LLM_BACKEND=ollama
LLM_HOST=localhost
LLM_PORT=11434
LLM_MODEL=qwen2.5:7b

# Embedding
EMBED_BACKEND=ollama
EMBED_MODEL=nomic-embed-text

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orchestrator
DB_USER=orchestrator
DB_PASS=changeme

# System Prompt
SYSTEM_PROMPT=You are a helpful enterprise AI assistant. You must always respond in Thai language only. Never use Chinese, English, or any other language. Thai language only.